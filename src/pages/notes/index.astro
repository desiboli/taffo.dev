---
import { getCollection } from "astro:content"
import MainLayout from "@/layouts/main.astro"
import Header from "@/components/Header.astro"
import SiteControls from "@/components/SiteControls.astro"
import AskAiAside from "@/components/AskAiAside.astro"
import { NotesExplorer } from "@/components/NotesExplorer"
import { toNoteItem } from "@/data/notes"

const notes = (await getCollection("notes", ({ data }) => !data.draft)).map(
  toNoteItem,
)
---

<MainLayout>
  <div class="page-grid content-start gap-y-1 pt-8 min-h-svh md:pt-14">
    <div class="min-w-0 px-4 md:col-start-2 md:row-start-1 md:px-0">
      <Header />
    </div>

    <SiteControls />
    <AskAiAside />

    <main class="min-w-0 self-start px-4 md:col-start-2 md:px-0">
      <section id="notes" class="mt-20">
        <h1 class="font-heading">Notes</h1>
        <h2 class="text-sm text-muted-foreground">
          Working snippets, patterns, and code notes I want to find again.
        </h2>

        <NotesExplorer client:load items={notes} />
      </section>
    </main>
  </div>
</MainLayout>
