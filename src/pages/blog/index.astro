---
import { getCollection } from "astro:content"
import FormattedDate from "../../components/FormattedDate.astro"
import MainLayout from "@/layouts/main.astro"
import Header from "@/components/Header.astro"
import SiteControls from "@/components/SiteControls.astro"
import AskAiAside from "@/components/AskAiAside.astro"

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)
---

<MainLayout>
  <div class="page-grid content-start gap-y-1 pt-8 min-h-svh md:pt-14">
    <div class="min-w-0 px-4 md:col-start-2 md:row-start-1 md:px-0">
      <Header />
    </div>

    <SiteControls />
    <AskAiAside />

    <main class="min-w-0 self-start px-4 md:col-start-2 md:px-0">
      <section id="blog" class="mt-20">
        <h1 class="font-heading">Writing</h1>
        <h2 class="text-sm text-muted-foreground">
          A collection of my thoughts and ideas.
        </h2>

        <div class="mt-4">
          <ul
            class="group/list -mx-2 divide-y divide-dashed divide-muted-foreground/50"
          >
            {
              posts.map((post) => (
                <li class="transition-[filter,opacity] duration-300 group-hover/list:not-[&:hover]:blur-[1px] group-hover/list:not-[&:hover]:opacity-50">
                  <a
                    href={`/blog/${post.id}/`}
                    data-cuelume-hover="press"
                    class="flex items-center justify-between gap-4 p-3 transition-colors hover:bg-muted"
                  >
                    <h3>{post.data.title}</h3>
                    <p class="shrink-0 text-sm text-muted-foreground">
                      <FormattedDate date={post.data.pubDate} />
                    </p>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </main>
  </div>
</MainLayout>
