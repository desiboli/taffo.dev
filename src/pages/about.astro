---
import MainLayout from "@/layouts/main.astro"
import Header from "@/components/Header.astro"
import SiteControls from "@/components/SiteControls.astro"
import AskAiAside from "@/components/AskAiAside.astro"
---

<MainLayout>
  <div class="page-grid content-start gap-y-1 pt-8 min-h-svh md:pt-14">
    <div class="min-w-0 px-4 md:col-start-2 md:row-start-1 md:px-0">
      <Header />
    </div>

    <SiteControls />
    <AskAiAside />

    <main class="min-w-0 self-start px-4 md:col-start-2 md:px-0">
      <section id="about" class="mt-20">
        <h1 class="font-heading">About</h1>
        <h2 class="text-sm text-muted-foreground">
          A bit about who I am outside the work stuff.
        </h2>

        <div class="mt-10 space-y-4 text-justify">
          <p>
            I was born and raised on Södermalm in Stockholm, and I've never
            really left. I grew up in a big family with five siblings — loud,
            close, and always something going on — which probably says a lot
            about how I show up in the world: warm, curious, and happiest around
            people.
          </p>
          <p>
            These days most of my time goes to my partner and our two young
            boys. Life with them is busy, fun, and nicely unpredictable. A lot
            of evenings and weekends are spent right there in the middle of it —
            and I wouldn't have it any other way.
          </p>
          <p>
            When I get a quiet moment, you'll usually find me following Real
            Madrid, Spanish football, and the Champions League. I also like
            gaming, and traveling when we can.
          </p>
          <p>
            Outside of that, I spend a lot of spare energy experimenting with AI
            tools and building small side projects just to learn and try things
            out. Right now I'm also studying a part-time distance course in{" "}
            <a
              href="https://www.technigo.io/courses/ai-native-development"
              target="_blank"
              rel="noopener noreferrer"
              class="underline underline-offset-2 hover:text-foreground transition-colors"
              data-cuelume-hover="tick"
            >
              AI Native Development
            </a>{" "}
            at Technigo — staying curious, and figuring out what building looks like
            next.
          </p>
        </div>
      </section>
    </main>
  </div>
</MainLayout>
