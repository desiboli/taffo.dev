---
// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
import AppHeader from "@/components/app-header.astro"
import { ClientsCarousel } from "@/components/clients-carousel"
import HeroBranding from "@/components/hero-branding.astro"
import Experience from "@/components/experience.astro"
import SocialLinkCard from "@/components/social-link-card.astro"
import { TestimonialCarousel } from "@/components/testimonial-carousel"
import DefaultLayout from "@/layouts/default-layout.astro"
---

<script is:inline>
  const updateTheme = () => {
    const wcb = document.getElementById("wcb")
    wcb?.classList.toggle(
      "wcb-d",
      document.documentElement.classList.contains("dark"),
    )
  }

  const init = () => {
    if (document.getElementById("wcb")) {
      updateTheme()
      new MutationObserver(updateTheme).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["class"],
      })
    } else {
      setTimeout(init, 100)
    }
  }

  init()
</script>

<DefaultLayout>
  <AppHeader />

  <main class="mt-10 mb-20">
    <section class="max-w-4xl mx-auto space-y-4 px-4">
      <HeroBranding />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <SocialLinkCard
          href="https://www.linkedin.com/in/mustafa-alshammaa/"
          logo="https://cdn.brandfetch.io/idJFz6sAsl/w/48/h/48/theme/dark/icon.png?c=1bxid64Mup7aczewSAYMX&t=1748592533197"
          title="LinkedIn"
          username="mustafa-alshammaa"
        />
        <SocialLinkCard
          href="https://github.com/desiboli"
          logo="https://cdn.brandfetch.io/idZAyF9rlg/w/48/h/48/theme/dark/icon.png?c=1bxid64Mup7aczewSAYMX&t=1719469970995"
          title="GitHub"
          username="desiboli"
        />
      </div>
      <h1 class="text-2xl md:text-3xl font-bold leading-snug text-justify">
        Hi, I’m Mustafa — a Senior Frontend Engineer with 10+ years of
        experience building, designing, and shipping web products end-to-end. I
        work at the intersection of frontend engineering, UX/UI, and product
        thinking, where understanding the user is just as important as writing
        great code. With modern tooling and AI-assisted workflows, I’m
        comfortable taking ideas from concept to production — sometimes solo,
        sometimes with a team. I thrive in environments where ownership matters,
        complexity is reduced, and real value is delivered fast.
      </h1>
    </section>

    <!-- <section>
      <div class="max-w-5xl mx-auto space-y-4 px-4 mt-20 mb-4">
        <h1 class="text-2xl font-bold">Clients I've worked with</h1>
      </div>
      <div class="max-w-5xl mx-auto px-4">
        <ClientsCarousel client:load />
      </div>
    </section> -->

    <section>
      <div class="max-w-4xl mx-auto space-y-4 px-4 mt-20 mb-4">
        <h1 class="text-2xl font-bold">What people say about me</h1>
      </div>
      <div class="w-full mx-auto">
        <TestimonialCarousel client:load />
      </div>
    </section>

    <Experience />
  </main>

  <footer class="my-20">
    <div class="max-w-4xl mx-auto px-4 space-y-4">
      <p class="text-center text-sm text-muted-foreground">
        &copy; {new Date().getFullYear()} Mustafa Alshammaa. All rights reserved.
      </p>
      <div id="wcb" class="carbonbadge"></div>
    </div>
  </footer>
</DefaultLayout>
