---
/**
 * Dark Carbon Spotlight — adapted from
 * https://opensourceui.in/components/dark-carbon-spotlight-background
 * MIT licensed. Shown in dark mode only.
 */
---

<div
  aria-hidden="true"
  data-slot="dark-carbon-spotlight-background"
  class="pointer-events-none fixed inset-0 -z-10 hidden overflow-hidden bg-[#0C0C0C] dark:block"
>
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_50%_12%,#121212_0%,#0E0E0E_40%,#0A0A0A_70%,#050505_100%)]"
  >
  </div>
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(255,255,255,0.03)_0%,transparent_28%)] opacity-[0.08]"
  >
  </div>
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_38%,rgba(0,0,0,0.7)_100%)]"
  >
  </div>
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.7)_1px,transparent_1px)] bg-size-[4px_4px] opacity-[0.03]"
  >
  </div>
</div>
