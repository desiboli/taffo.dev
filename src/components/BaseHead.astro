---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css"
import type { ImageMetadata } from "astro"
import { Font } from "astro:assets"
import {
  SITE_AUTHOR,
  SITE_DESCRIPTION,
  SITE_LOCALE,
  SITE_NAME,
  SITE_OG_IMAGE,
  SITE_OG_IMAGE_ALT,
  SITE_OG_IMAGE_HEIGHT,
  SITE_OG_IMAGE_WIDTH,
  SITE_SAME_AS,
  SITE_TITLE,
} from "../consts"

interface Props {
  title: string
  description: string
  image?: ImageMetadata | string
  imageAlt?: string
  type?: "website" | "article"
  pubDate?: Date
  updatedDate?: Date
  noindex?: boolean
}

const {
  title,
  description,
  image = SITE_OG_IMAGE,
  imageAlt = SITE_OG_IMAGE_ALT,
  type = "website",
  pubDate,
  updatedDate,
  noindex = false,
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const siteOrigin = Astro.site ?? canonicalURL

const resolveImage = (
  img: ImageMetadata | string,
): { url: URL; width?: number; height?: number } => {
  if (typeof img === "string") {
    return {
      url: new URL(img, siteOrigin),
      width: img === SITE_OG_IMAGE ? SITE_OG_IMAGE_WIDTH : undefined,
      height: img === SITE_OG_IMAGE ? SITE_OG_IMAGE_HEIGHT : undefined,
    }
  }
  return {
    url: new URL(img.src, siteOrigin),
    width: img.width,
    height: img.height,
  }
}

const ogImage = resolveImage(image)

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_TITLE,
  alternateName: SITE_NAME,
  url: siteOrigin.href,
  description: SITE_DESCRIPTION,
  inLanguage: "en",
  author: {
    "@type": "Person",
    name: SITE_AUTHOR,
    url: siteOrigin.href,
    sameAs: [...SITE_SAME_AS],
  },
}

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE_AUTHOR,
  url: siteOrigin.href,
  jobTitle: "Software Engineer",
  description: SITE_DESCRIPTION,
  image: new URL("/m.webp", siteOrigin).href,
  sameAs: [...SITE_SAME_AS],
}

const articleJsonLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        image: ogImage.url.href,
        datePublished: pubDate?.toISOString(),
        dateModified: (updatedDate ?? pubDate)?.toISOString(),
        author: {
          "@type": "Person",
          name: SITE_AUTHOR,
          url: siteOrigin.href,
        },
        publisher: {
          "@type": "Person",
          name: SITE_AUTHOR,
          url: siteOrigin.href,
        },
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": canonicalURL.href,
        },
        inLanguage: "en",
      }
    : null

const jsonLdGraph = [websiteJsonLd, personJsonLd, articleJsonLd].filter(Boolean)
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,interactive-widget=resizes-content" />
<meta name="generator" content={Astro.generator} />
<meta name="author" content={SITE_AUTHOR} />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  )
}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="manifest" href="/site.webmanifest" />

<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE_TITLE} — Writing`}
  href={new URL("rss.xml", siteOrigin)}
/>

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={SITE_LOCALE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage.url} />
<meta property="og:image:alt" content={imageAlt} />
{ogImage.width && <meta property="og:image:width" content={String(ogImage.width)} />}
{ogImage.height && <meta property="og:image:height" content={String(ogImage.height)} />}
{
  type === "article" && pubDate && (
    <meta property="article:published_time" content={pubDate.toISOString()} />
  )
}
{
  type === "article" && (updatedDate ?? pubDate) && (
    <meta
      property="article:modified_time"
      content={(updatedDate ?? pubDate)!.toISOString()}
    />
  )
}
{type === "article" && <meta property="article:author" content={SITE_AUTHOR} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.url} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />

{
  import.meta.env.PROD && (
    <script
      is:inline
      data-goatcounter="https://taffo.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"
    />
  )
}
