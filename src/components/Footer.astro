---
import { version } from '../../package.json'

const today = new Date()
---

<footer>
  <div class="page-grid py-40">
    <div class="flex w-full items-center justify-between gap-4 px-4 md:col-start-2 md:px-0">
      <h2 class="font-handwriting text-2xl font-bold">Mustafa</h2>
      <p class="text-sm text-muted-foreground">
        &copy; {today.getFullYear()} · Mustafa Alshammaa.
      </p>
    </div>
  </div>
  <div class="page-grid pb-6">
    <div
      class="flex flex-col items-center gap-4 px-4 md:col-start-2 md:px-0"
    >
      <div id="wcb" class="carbonbadge"></div>
      <p
        class="text-center text-[10px] tracking-wide text-muted-foreground/60"
        aria-label={`Site version ${version}`}
      >
        v{version}<span id="site-views" hidden></span>
      </p>
    </div>
  </div>
</footer>

<!-- Website Carbon badge: https://www.websitecarbon.com/badge/ -->
<script is:inline src="https://unpkg.com/website-carbon-badges@1.1.3/b.min.js" defer></script>
<script is:inline>
  const updateCarbonBadgeTheme = () => {
    const wcb = document.getElementById("wcb")
    wcb?.classList.toggle(
      "wcb-d",
      document.documentElement.classList.contains("dark"),
    )
  }

  const initCarbonBadgeTheme = () => {
    if (document.getElementById("wcb")) {
      updateCarbonBadgeTheme()
      new MutationObserver(updateCarbonBadgeTheme).observe(
        document.documentElement,
        { attributes: true, attributeFilter: ["class"] },
      )
    } else {
      setTimeout(initCarbonBadgeTheme, 100)
    }
  }

  initCarbonBadgeTheme()
</script>

{
  import.meta.env.PROD && (
    <script is:inline>
      fetch("https://taffo.goatcounter.com/counter/TOTAL.json")
        .then((r) => (r.ok ? r.json() : Promise.reject()))
        .then((d) => {
          const el = document.getElementById("site-views")
          if (!el || !d.count) return
          el.textContent = ` · ${d.count} views`
          el.hidden = false
        })
        .catch(() => {})
    </script>
  )
}
