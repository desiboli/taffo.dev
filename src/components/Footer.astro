---
import { version } from '../../package.json'

const today = new Date()
---

<footer>
  <div class="page-grid py-40">
    <div class="flex w-full flex-col gap-6 px-4 md:col-start-2 md:px-0">
      <div class="flex items-center justify-between gap-4">
        <h2 class="font-handwriting text-2xl font-bold">Mustafa</h2>
        <p class="text-sm text-muted-foreground">
          &copy; {today.getFullYear()} · Mustafa Alshammaa.
        </p>
      </div>
      <p class="text-xs text-muted-foreground/70" aria-label={`Site version ${version}`}>
        v{version}
      </p>
    </div>
  </div>
</footer>
